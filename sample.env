
OPENAI_KEY=""

# --- LLM Model Configuration ---
CHATBOT_MODEL="gpt-4o-mini"
DOMAIN_CLASSIFIER_MODEL="gpt-4o-mini"
QUERY_REWRITER_MODEL="gpt-4o-mini"
SUMMARY_MODEL="gpt-4o-mini"

# --- LLM Parameter Configuration ---
CHATBOT_TEMPERATURE=0.3
DOMAIN_CLASSIFIER_TEMPERATURE=0.0
DOMAIN_CLASSIFIER_MAX_TOKENS=5
QUERY_REWRITER_TEMPERATURE=0.0
QUERY_REWRITER_MAX_TOKENS=50
SUMMARY_TEMPERATURE=0.3
SUMMARY_MAX_TOKENS=150

# --- History and Context Limits ---
HISTORY_LIMIT_FOR_LLM=10
SUMMARY_HISTORY_LIMIT=10
HISTORY_LIMIT_FOR_CONTEXT=4
DOMAIN_CHECK_HISTORY_SIZE=2
DOMAIN_CHECK_RAG_SUMMARY_COUNT=2

# --- Neural Search Configuration ---
QDRANT_MODEL_NAME="all-MiniLM-L6-v2"
QDRANT_COLLECTION_NAME="startups"
QDRANT_PORT=6333
QDRANT_PORT_SSL=6334
QDRANT_URL="http://localhost:${QDRANT_PORT}"
QDRANT_TOP_K=7

# --- Database Configuration ---
DATABASE_URL="sqlite:///database/conversation.db"

# --- Application Behavior ---
DEFAULT_USER_ID="default user"
DEFAULT_SESSION_ID="default_session"
MESSAGE_STATUS_CHECK_DELAY_SECONDS=1.0
QUERY_REWRITER_MIN_LENGTH=3
REJECTION_MESSAGE="My expertise is limited to startups and venture capital. Please ask a relevant question."
NO_HISTORY_SUMMARY_MESSAGE="No conversation history available for this user/session to summarize."

# --- API Server Configuration ---
API_TITLE="Startup Knowledge Chatbot API"
UVICORN_HOST="0.0.0.0"
UVICORN_PORT=8000
UVICORN_RELOAD=False

UI_PORT=3000
UI_URL="http://localhost:${UI_PORT}"

# --- Logging Configuration ---
LOG_LEVEL="INFO"
LOG_FORMAT='%(asctime)s - %(name)s - %(levelname)s - %(message)s'
